{
  "collections": {
    "highscores": {
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "trim": true,
          "maxLength": 20
        },
        "score": {
          "type": "integer",
          "required": true,
          "minimum": 0,
          "maximum": 10000000
        },
        "platform": {
          "type": "string",
          "required": true,
          "trim": true,
          "maxLength": 12
        },
        "difficulty": {
          "type": "string",
          "required": true,
          "trim": true,
          "maxLength": 12
        }
      },
      "access": {
        "read": "public",
        "insert": "public",
        "update": "owner",
        "delete": "owner"
      }
    }
  }
}
